# Node 24; copy to .env.local. Synthetic demo only.
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/aeconn.sqlite
DEMO_PASSWORD=AeconnDemo!2026
MAIL_MODE=dry_run
UNREVIEWED_SEND_POLICY=pending
# Development checkpoint. Selectors accept mock|openai|gemini.
# mock makes no cloud call even if cloud keys exist; it is not Charles v1 acceptance.
LLM_PROVIDER=mock
VOICE_PROVIDER=mock
# Selected validation path: explicitly choose openai and fill models available to your account.
# Keep keys empty here. Local credential/test status is recorded in docs/acceptance.md.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_REALTIME_MODEL=
# Realtime input transcription: gpt-4o-mini-transcribe (default) or whisper-1.
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Application spending protection (USD); daily/monthly periods use UTC.
# Pending/unknown charges retain their allowance. These are not provider billing caps.
AI_CASE_BUDGET_USD=2
AI_DAILY_BUDGET_USD=5
AI_MONTHLY_BUDGET_USD=20
# Additional realtime guard: at most 20 minutes per connection.
OPENAI_VOICE_MAX_SECONDS=1200
# Optional retained Gemini provider.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_LIVE_MODEL=
GEMINI_TIMEOUT_MS=30000
# Explicitly opt in only for trusted HTTPS reverse-proxy testing; change demo password first.
ALLOW_NETWORK_DEMO=false
# Only needed for opt-in network testing behind a trusted HTTPS reverse proxy.
HTTPS_PROXY_ORIGIN=
