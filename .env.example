# Node 24; copy to .env.local. Synthetic demo only.
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/aeconn.sqlite
DEMO_PASSWORD=AeconnDemo!2026
MAIL_MODE=dry_run
UNREVIEWED_SEND_POLICY=pending
# Current UI prototype: explicit mock selectors make no cloud call, even if keys exist.
LLM_PROVIDER=mock
VOICE_PROVIDER=mock
# Later cloud validation: explicitly change the relevant selector to gemini and set its model.
# Real cloud use has NOT been validated in the default prototype configuration.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_LIVE_MODEL=
GEMINI_TIMEOUT_MS=30000
# Explicitly opt in only for trusted HTTPS reverse-proxy testing; change demo password first.
ALLOW_NETWORK_DEMO=false
# Only needed for opt-in network testing behind a trusted HTTPS reverse proxy.
HTTPS_PROXY_ORIGIN=
